{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist/server",
    "rootDir": ".",
    "typeRoots": ["./@types", "./node_modules/@types"]
  },
  "include": [
    "server/**/*.ts",
    "schemas/**/*.json",
    "clients/**/*.ts",
    "@types/**/*.d.ts"
  ],
  "exclude": [
    "web/**",
    "node_modules/**"
  ]
}
